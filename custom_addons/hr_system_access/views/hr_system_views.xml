<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_system_view_list" model="ir.ui.view">
        <field name="name">hr.system.list</field>
        <field name="model">hr.system</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="url"/>
                <field name="account_count"/>
                <field name="valid_from"/>
                <field name="valid_until"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>

    <record id="hr_system_view_form" model="ir.ui.view">
        <field name="name">hr.system.form</field>
        <field name="model">hr.system</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Nazwa systemu"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="url"/>
                            <field name="is_active"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="valid_from"/>
                            <field name="valid_until"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Konta" name="accounts">
                            <field name="account_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="login"/>
                                    <field name="email"/>
                                    <field name="phone"/>
                                    <field name="is_active"/>
                                    <field name="access_count"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_system_account_view_list" model="ir.ui.view">
        <field name="name">hr.system.account.list</field>
        <field name="model">hr.system.account</field>
        <field name="arch" type="xml">
            <list>
                <field name="system_id"/>
                <field name="name"/>
                <field name="login"/>
                <field name="email"/>
                <field name="access_count"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>

    <record id="hr_system_account_view_form" model="ir.ui.view">
        <field name="name">hr.system.account.form</field>
        <field name="model">hr.system.account</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="login"/>
                        <h1><field name="login" placeholder="Login"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="system_id"/>
                            <field name="name"/>
                            <field name="email"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="is_active"/>
                            <field name="valid_from"/>
                            <field name="valid_until"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Dostępy" name="accesses">
                            <field name="access_ids">
                                <list editable="bottom">
                                    <field name="employee_id"/>
                                    <field name="tag_ids" widget="many2many_tags"/>
                                    <field name="valid_from"/>
                                    <field name="valid_until"/>
                                    <field name="is_active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_system_account_access_view_list" model="ir.ui.view">
        <field name="name">hr.system.account.access.list</field>
        <field name="model">hr.system.account.access</field>
        <field name="arch" type="xml">
            <list>
                <field name="system_id"/>
                <field name="account_id"/>
                <field name="employee_id"/>
                <field name="tag_ids" widget="many2many_tags"/>
                <field name="valid_from"/>
                <field name="valid_until"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>

    <record id="hr_system_account_access_view_form" model="ir.ui.view">
        <field name="name">hr.system.account.access.form</field>
        <field name="model">hr.system.account.access</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="account_id"/>
                            <field name="system_id"/>
                            <field name="employee_id"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="is_active"/>
                            <field name="valid_from"/>
                            <field name="valid_until"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_system_account_tag_view_list" model="ir.ui.view">
        <field name="name">hr.system.account.tag.list</field>
        <field name="model">hr.system.account.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="hr_system_account_tag_view_form" model="ir.ui.view">
        <field name="name">hr.system.account.tag.form</field>
        <field name="model">hr.system.account.tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color_picker"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_system_action" model="ir.actions.act_window">
        <field name="name">Systemy</field>
        <field name="res_model">hr.system</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="hr_system_account_action" model="ir.actions.act_window">
        <field name="name">Konta</field>
        <field name="res_model">hr.system.account</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="hr_system_account_access_action" model="ir.actions.act_window">
        <field name="name">Dostępy</field>
        <field name="res_model">hr.system.account.access</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="hr_system_account_tag_action" model="ir.actions.act_window">
        <field name="name">Role</field>
        <field name="res_model">hr.system.account.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="hr_system_access_menu_root" name="Dostępy do systemów" parent="hr.menu_hr_root" sequence="50"/>
    <menuitem id="hr_system_menu" name="Systemy" parent="hr_system_access_menu_root" action="hr_system_action" sequence="10"/>
    <menuitem id="hr_system_account_menu" name="Konta" parent="hr_system_access_menu_root" action="hr_system_account_action" sequence="20"/>
    <menuitem id="hr_system_account_access_menu" name="Dostępy" parent="hr_system_access_menu_root" action="hr_system_account_access_action" sequence="30"/>
    <menuitem id="hr_system_account_tag_menu" name="Role" parent="hr_system_access_menu_root" action="hr_system_account_tag_action" sequence="40"/>
</odoo>
