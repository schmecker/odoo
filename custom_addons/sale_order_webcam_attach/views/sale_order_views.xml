<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_webcam_attach" model="ir.ui.view">
        <field name="name">sale.order.form.webcam.attach</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_webcam_capture"
                        type="object"
                        string="Zrób zdjęcie"
                        class="btn-secondary"
                        icon="fa-camera"
                        invisible="not id"
                        groups="sales_team.group_sale_salesman"/>
            </xpath>
        </field>
    </record>
</odoo>
